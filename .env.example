# Provider-neutral deployment placeholders only. Do not put real secrets in this file.
APP_ENV=production
AD_ANALYZER_WORKSPACE_ID=1
DATABASE_URL=postgresql+psycopg://ad_analyzer:replace-with-external-secret@postgres:5432/ad_analyzer?sslmode=require
# Cloud Run alternative: set all four variables and inject the password from Secret Manager.
CLOUD_SQL_CONNECTION_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SSL_MODE=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
AD_ANALYZER_API_TOKEN=replace-with-external-secret
# Inject this value from Secret Manager; never store the real HMAC secret here.
AD_ANALYZER_CRM_WEBHOOK_SECRET=replace-with-external-secret
AD_ANALYZER_CRM_PUBSUB_PROJECT_ID=totemic-alchemy-502420-p4
AD_ANALYZER_CRM_PUBSUB_TOPIC_ID=crm-events
AD_ANALYZER_CRM_PUBSUB_SUBSCRIPTION_ID=
AD_ANALYZER_REQUIRED_SECRET_NAMES=AD_ANALYZER_API_TOKEN,DATABASE_URL
AD_ANALYZER_SECRET_REFERENCE_PREFIX=
AD_ANALYZER_DASHBOARD_ALLOW_INSECURE_LOCAL_HTTP=false
# Direct Cloud Run IAP audience: /projects/PROJECT_NUMBER/locations/REGION/services/SERVICE_NAME.
AD_ANALYZER_IAP_AUDIENCE=
# Comma-separated platform administrators. Workspace users are stored per workspace.
AD_ANALYZER_PLATFORM_ADMIN_EMAILS=
# Optional GitHub control-plane bridge. Inject the token from Secret Manager and grant only
# repository Variables write access to the named repository.
AD_ANALYZER_GITHUB_CONTROL_TOKEN=
AD_ANALYZER_GITHUB_CONTROL_REPOSITORY=Konner-An-Inlet/Ad-Analyzer

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Optional Meta read-only connection. Configure on both web and existing sync worker.
# Inject the client secret and Fernet token key through the existing secret manager.
AD_ANALYZER_META_ENABLED=false
META_CLIENT_ID=
META_CLIENT_SECRET=
META_TOKEN_ENCRYPTION_KEY=
META_REDIRECT_URI=
META_SYNC_PAGES=3
META_SYNC_INTERVAL_MINUTES=60

# Safety guards: preserve these values unless a future approved phase changes policy.
AD_ANALYZER_GOOGLE_ADS_WRITE_ENABLED=false
AD_ANALYZER_GOOGLE_ADS_EXECUTION_KILL_SWITCH=true
AD_ANALYZER_ALLOWED_EXECUTION_ACCOUNT_IDS=
AD_ANALYZER_ALLOWED_GOOGLE_ADS_MUTATIONS=

# Separate runtime process controls.
AD_ANALYZER_WEB_CONCURRENCY=2
AD_ANALYZER_WORKER_CONCURRENCY=1
AD_ANALYZER_SCHEDULER_CONCURRENCY=1
AD_ANALYZER_WEB_TIMEOUT_SECONDS=60
AD_ANALYZER_WORKER_TIMEOUT_SECONDS=900
AD_ANALYZER_SCHEDULER_TIMEOUT_SECONDS=300
AD_ANALYZER_MIGRATION_TIMEOUT_SECONDS=900
AD_ANALYZER_GRACEFUL_SHUTDOWN_SECONDS=30

# Conservative worker defaults. Keep this file credential-free.
AD_ANALYZER_SYNC_INTERVAL_MINUTES=60
AD_ANALYZER_SYNC_RUN_IMMEDIATELY=false
AD_ANALYZER_SYNC_MAX_ATTEMPTS=3
AD_ANALYZER_SYNC_RETRY_BASE_SECONDS=5
AD_ANALYZER_SYNC_RETRY_MAX_SECONDS=60
AD_ANALYZER_SYNC_STALE_AFTER_MINUTES=180
AD_ANALYZER_SYNC_ADVISORY_LOCK_KEY=719042711

# Optional local Compose placeholders; production values should come from external secrets.
POSTGRES_DB=ad_analyzer
POSTGRES_USER=ad_analyzer
POSTGRES_PASSWORD=replace-with-external-secret
AD_ANALYZER_IMAGE_TAG=local
AD_ANALYZER_HTTP_BIND=127.0.0.1:8000

# Shopify sales (disabled until app, protected-data access, Pub/Sub and release checks are ready).
# Supply secrets through the managed runtime; never paste credentials into this file.
AD_ANALYZER_SHOPIFY_ENABLED=false
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_TOKEN_ENCRYPTION_KEY=
SHOPIFY_IDENTIFIER_HASH_KEY=
SHOPIFY_REDIRECT_URI=
SHOPIFY_WEBHOOK_SUBSCRIPTION=
SHOPIFY_SYNC_PAGES=10
SHOPIFY_SYNC_INTERVAL_MINUTES=60

# Inlet customer authentication (disabled until separately approved provider/deployment setup)
INLET_CUSTOMER_AUTH_ENABLED=false
INLET_IDENTITY_PROJECT_ID=
INLET_CUSTOMER_APP_ORIGIN=

# B04: explicit operator-managed Google import ownership; no tenant defaults.
# Leave unset until existing account/connection ownership is reviewed.
# INLET_GOOGLE_ADS_WORKSPACE_ID=
# INLET_GOOGLE_ADS_CONNECTION_ID=
# INLET_GOOGLE_ADS_ACCOUNT_ID=
INLET_GOOGLE_ADS_CREDENTIALS_REFERENCE=
# CRM ingress uses each connection's pinned Secret Manager reference (see docs/inlet-import-ownership.md).
# AD_ANALYZER_CRM_WEBHOOK_SECRET above is legacy configuration, not an ingress fallback.
