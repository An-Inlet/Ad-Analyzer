# Provider-neutral deployment placeholders only. Do not put real secrets in this file.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://denticode:replace-with-external-secret@postgres:5432/denticode_ads_optimizer
DENTICODE_API_TOKEN=replace-with-external-secret
DENTICODE_DASHBOARD_ALLOW_INSECURE_LOCAL_HTTP=false

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Safety guards: preserve these values unless a future approved phase changes policy.
DENTICODE_GOOGLE_ADS_WRITE_ENABLED=false
DENTICODE_GOOGLE_ADS_EXECUTION_KILL_SWITCH=true
DENTICODE_ALLOWED_EXECUTION_ACCOUNT_IDS=
DENTICODE_ALLOWED_GOOGLE_ADS_MUTATIONS=

# Conservative worker defaults. Keep this file credential-free.
DENTICODE_SYNC_INTERVAL_MINUTES=60
DENTICODE_SYNC_RUN_IMMEDIATELY=false
DENTICODE_SYNC_MAX_ATTEMPTS=3
DENTICODE_SYNC_RETRY_BASE_SECONDS=5
DENTICODE_SYNC_RETRY_MAX_SECONDS=60
DENTICODE_SYNC_STALE_AFTER_MINUTES=180
DENTICODE_SYNC_ADVISORY_LOCK_KEY=719042711

# Optional local Compose placeholders; production values should come from external secrets.
POSTGRES_DB=denticode_ads_optimizer
POSTGRES_USER=denticode
POSTGRES_PASSWORD=replace-with-external-secret
DENTICODE_IMAGE_TAG=local
DENTICODE_HTTP_BIND=127.0.0.1:8000
