# Provider-neutral deployment placeholders only. Do not put real secrets in this file.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://denticode:replace-with-external-secret@postgres:5432/denticode_ads_optimizer?sslmode=require
# Cloud Run alternative: set all four variables and inject the password from Secret Manager.
CLOUD_SQL_CONNECTION_NAME=
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=
DATABASE_SSL_MODE=require
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_RECYCLE_SECONDS=1800
DENTICODE_API_TOKEN=replace-with-external-secret
DENTICODE_REQUIRED_SECRET_NAMES=DENTICODE_API_TOKEN,DATABASE_URL
DENTICODE_SECRET_REFERENCE_PREFIX=
DENTICODE_DASHBOARD_ALLOW_INSECURE_LOCAL_HTTP=false
# IAP OAuth client audience (typically /projects/PROJECT_NUMBER/global/backendServices/SERVICE_ID).
DENTICODE_IAP_AUDIENCE=
# Comma-separated operator emails. Configure in the deployment environment, not source control.
DENTICODE_DASHBOARD_ALLOWED_EMAILS=

GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=

# Safety guards: preserve these values unless a future approved phase changes policy.
DENTICODE_GOOGLE_ADS_WRITE_ENABLED=false
DENTICODE_GOOGLE_ADS_EXECUTION_KILL_SWITCH=true
DENTICODE_ALLOWED_EXECUTION_ACCOUNT_IDS=
DENTICODE_ALLOWED_GOOGLE_ADS_MUTATIONS=

# Separate runtime process controls.
DENTICODE_WEB_CONCURRENCY=2
DENTICODE_WORKER_CONCURRENCY=1
DENTICODE_SCHEDULER_CONCURRENCY=1
DENTICODE_WEB_TIMEOUT_SECONDS=60
DENTICODE_WORKER_TIMEOUT_SECONDS=900
DENTICODE_SCHEDULER_TIMEOUT_SECONDS=300
DENTICODE_MIGRATION_TIMEOUT_SECONDS=900
DENTICODE_GRACEFUL_SHUTDOWN_SECONDS=30

# Conservative worker defaults. Keep this file credential-free.
DENTICODE_SYNC_INTERVAL_MINUTES=60
DENTICODE_SYNC_RUN_IMMEDIATELY=false
DENTICODE_SYNC_MAX_ATTEMPTS=3
DENTICODE_SYNC_RETRY_BASE_SECONDS=5
DENTICODE_SYNC_RETRY_MAX_SECONDS=60
DENTICODE_SYNC_STALE_AFTER_MINUTES=180
DENTICODE_SYNC_ADVISORY_LOCK_KEY=719042711

# Optional local Compose placeholders; production values should come from external secrets.
POSTGRES_DB=denticode_ads_optimizer
POSTGRES_USER=denticode
POSTGRES_PASSWORD=replace-with-external-secret
DENTICODE_IMAGE_TAG=local
DENTICODE_HTTP_BIND=127.0.0.1:8000
