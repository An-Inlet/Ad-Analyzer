+"""Independent exercise of actual0075 DDL on disposable fixture schemas."""
+
+import importlib
+
+from alembic.migration import MigrationContext
+from alembic.operations import Operations
+from sqlalchemy import inspect
+
+from tests.test_customer_identity import customer_engine as customer_engine
+from tests.test_meta_connection import configuration as configuration
+from tests.test_initial_observations import (
+    test_dependency_delete_erases_parent_and_expiry_export_fence as dependency_check,
+)
+
+
+def test_actual_migration_dependency_erase_and_roundtrip(customer_engine, configuration, monkeypatch):
+    migration = importlib.import_module("migrations.versions.20261006_0075_initial_planning")
+    with customer_engine.begin() as connection:
+        with Operations.context(MigrationContext.configure(connection)):
+            migration.downgrade()
+            assert "initial_observations" not in inspect(connection).get_table_names()
+            migration.upgrade()
+    dependency_check(customer_engine, configuration, monkeypatch, False)
+    with customer_engine.begin() as connection:
+        with Operations.context(MigrationContext.configure(connection)):
+            migration.downgrade()
+            migration.upgrade()
+        assert "initial_calibration_dependencies" in inspect(connection).get_table_names()
